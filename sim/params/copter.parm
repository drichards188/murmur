# Layered on top of ArduPilot's built-in copter defaults.
# Bit 0: allow arming in AUTO. Bit 1: start an AUTO takeoff without raising RC throttle
# (there is no RC transmitter in this sim).
AUTO_OPTIONS 3
# GCS (lost-link) failsafe on, as the stand-ins have it (ArduCopter ships it off): RTL when no
# GCS heartbeat for FS_GCS_TIMEOUT, which swarm.py sets from the link profile (lost_link_s in
# sim/links.toml).
FS_GCS_ENABLE 1
